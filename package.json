{
  "name": "chaide-digital-library",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:firebase": "node scripts/prepare-static-site.mjs && vite build --mode firebase",
    "build:pages": "node scripts/prepare-static-site.mjs && vite build --outDir dist-pages",
    "verify:pdfs": "node scripts/verify-pdf-library.mjs",
    "verify:assistant": "tsx scripts/verify-catalog-assistant.mts",
    "verify:assistant-corpus": "tsx scripts/verify-assistant-corpus.mts",
    "verify:global-search": "node scripts/verify-global-search-index.mjs",
    "backup:firestore": "node scripts/export-firestore-backup.mjs",
    "backup:encrypt": "node scripts/encrypt-firestore-backup.mjs",
    "backup:decrypt": "node scripts/decrypt-firestore-backup.mjs",
    "cleanup:firestore-orphans": "node scripts/cleanup-firestore-orphans.mjs",
    "migrate:publication-fields": "node scripts/backfill-publication-fields.mjs",
    "migrate:global-search": "node scripts/backfill-global-search-index.mjs",
    "repair:search-index": "node scripts/repair-search-index-from-pdf.mjs",
    "configure:github-firebase": "node scripts/configure-firebase-github-deploy.mjs",
    "revoke:local-firebase-key": "node scripts/revoke-local-firebase-key.mjs",
    "configure:github-backup": "node scripts/configure-github-backup-secret.mjs",
    "deploy:assistant": "npx wrangler deploy --config workers/catalog-assistant/wrangler.jsonc",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "install-fb": "npm install firebase"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@aws-sdk/lib-storage": "^3.1137.0",
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^12.38.0",
    "googleapis": "^173.0.0",
    "idb-keyval": "^6.2.2",
    "lenis": "^1.3.23",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.4.168",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-pageflip": "^2.0.3",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.15.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "shadcn": "^4.7.0",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "use-resize-observer": "^9.1.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "libsodium-wrappers": "^0.7.15",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
