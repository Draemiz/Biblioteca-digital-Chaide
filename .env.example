# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Backblaze B2 S3-compatible storage. Server-side only.
B2_ENDPOINT="https://s3.REGION.backblazeb2.com"
B2_REGION="REGION"
B2_BUCKET_NAME="YOUR_BUCKET_NAME"
B2_KEY_ID="YOUR_KEY_ID"
B2_APPLICATION_KEY="YOUR_APPLICATION_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Required to enable write/admin API endpoints. Keep this value server-side.
ADMIN_TOKEN="CHANGE_ME"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME"

# Hosting providers set PORT automatically.
PORT="3000"

# Railway persistent volume mount.
DATA_DIR="/data"
# Optional no-cost Cloudflare Workers AI endpoint. If it is unavailable or the
# free daily quota is exhausted, the catalogue assistant falls back locally.
VITE_CATALOG_ASSISTANT_API_URL=
