{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chaide-catalog-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://biblioteca-catalogos-chaide.web.app,https://biblioteca-catalogos-chaide.firebaseapp.com,http://localhost:5173,http://localhost:3000"
  }
}
